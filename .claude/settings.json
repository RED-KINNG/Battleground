{
  "permissions": {
    "deny": [
      "Bash(git push:*)",
      "Bash(git push)",
      "PowerShell(git push:*)",
      "PowerShell(git push)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/require-context7.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
